# ============================================================
# EAJ Ticketing — PRODUCTION environment template
# Copy to .env on the server, fill in real values, then run:
#   php artisan key:generate && php artisan migrate --force
#   npm ci && npm run build
#   php artisan storage:link && php artisan optimize
# ============================================================

APP_NAME="EAJ Support"
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false                # NEVER true in production
APP_URL=https://support.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- First-run admin account (used by db:seed) ---
SEED_ADMIN_NAME="EAJ Admin"
SEED_ADMIN_EMAIL=admin@eaj.com
SEED_ADMIN_PASSWORD=          # set a strong password BEFORE seeding

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_eaj_ticketing
DB_USERNAME=eaj_app            # dedicated user, NOT root
DB_PASSWORD=                   # strong password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database      # run: php artisan queue:work (Supervisor)
CACHE_STORE=database           # or redis if available

# --- Mail (for invites / password links) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Reverb (WebSockets) — regenerate all three for production! ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=support.yourdomain.com   # public hostname clients connect to
REVERB_PORT=443
REVERB_SCHEME=https
# Reverb itself listens locally; proxy wss:// through nginx to :8080
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
